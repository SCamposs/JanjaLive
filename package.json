{
  "name": "janjalive",
  "version": "0.1.38",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx src/db/migrate-on-deploy.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security-db": "vitest run --config vitest.postgres.config.mts",
    "test:coverage": "vitest run --coverage",
    "desktop:dev": "pnpm --filter @janjalive/desktop dev",
    "desktop:build": "pnpm --filter @janjalive/desktop build",
    "desktop:test": "pnpm --filter @janjalive/desktop test",
    "desktop:package": "pnpm --filter @janjalive/desktop package:win",
    "desktop:package:store": "pnpm --filter @janjalive/desktop package:store",
    "desktop:package:store:preview": "pnpm --filter @janjalive/desktop package:store:preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:all": "pnpm check && pnpm desktop:test && pnpm desktop:build"
  },
  "dependencies": {
    "@janjalive/realtime-protocol": "workspace:*",
    "@janjalive/ui": "workspace:*",
    "@janjalive/webrtc": "workspace:*",
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.66.0",
    "jose": "6.2.15",
    "nanoid": "^6.0.1",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "8.3.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.19.0"
}
