{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "janjalive-realtime",
  "main": "src/index.ts",
  "preview_urls": false,
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat", "web_socket_auto_reply_to_close"],
  "vars": {
    "ALLOWED_ORIGINS": "https://janja.live,https://www.janja.live,janja-app://bundle"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      { "name": "RATE_LIMITS", "class_name": "RateLimitDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject", "RateLimitDurableObject"]
    }
  ],
  "observability": { "enabled": true }
}
