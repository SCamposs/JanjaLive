{
  "name": "@janjalive/desktop",
  "version": "0.1.7",
  "description": "Cliente desktop seguro do JanjaLive para compartilhamento P2P de tela.",
  "author": "SCamposs",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --publish never && pnpm smoke:packaged",
    "smoke:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged.ps1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@janjalive/webrtc": "workspace:*",
    "electron-updater": "6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
