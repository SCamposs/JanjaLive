# PostgreSQL (Neon pooled connection string)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_URL=http://localhost:3000

# Single-owner operational administration. Server-side only; never expose as NEXT_PUBLIC_*.
ADMIN_USER_ID=
ADMIN_DISCORD_USER_ID=

# Protects the Vercel Cron endpoint that removes long-expired rooms.
CRON_SECRET=

# Realtime provider. Use cloudflare in production, upstash only for rollback,
# or disabled for an explicit maintenance state.
REALTIME_PROVIDER=cloudflare
CLOUDFLARE_REALTIME_URL=
REALTIME_TOKEN_SECRET=
REALTIME_INTERNAL_SECRET=

# Optional rollback provider. Signaling data expires after 180 seconds;
# no media or WebRTC negotiation data is persisted in PostgreSQL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The Vercel Marketplace integration may provide these aliases instead.
# The application accepts either pair; do not duplicate credentials unnecessarily.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Recommended in production. Without TURN, some mobile, NAT and firewall paths cannot connect.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional emergency gate for critically vulnerable desktop versions.
# Leave unset during normal operation.
MINIMUM_DESKTOP_VERSION=
